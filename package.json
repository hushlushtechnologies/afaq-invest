{
  "name": "afaq-invest",
  "version": "0.1.0",
  "private": true,
  "description": "Afaq Invest — investment management platform for Afaq Al Barakha Investment",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --concurrency=20",
    "dev:admin": "turbo run dev --filter=@afaq/admin...",
    "dev:investor": "turbo run dev --filter=@afaq/investor...",
    "dev:partner": "turbo run dev --filter=@afaq/partner...",
    "dev:api": "turbo run dev --filter=@afaq/api...",
    "db:generate": "pnpm --filter @afaq/database db:generate",
    "db:status": "pnpm --filter @afaq/database db:status",
    "db:migrate": "pnpm --filter @afaq/database db:migrate",
    "db:studio": "pnpm --filter @afaq/database db:studio",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
