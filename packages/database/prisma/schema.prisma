// Afaq Invest — database schema.

//

// Prisma 7: the connection URL lives in prisma.config.ts, not here.

//

// Sprint 3 adds the authentication and authorization foundation. Identity

// (passwords, sessions, recovery emails) belongs to Supabase Auth and is never

// duplicated here; this schema owns application-level authorization: who the

// staff are, what they may do, and what they did.

generator client {

  provider     = "prisma-client"

  output       = "../src/generated/prisma"

  moduleFormat = "cjs"

}

datasource db {

  provider = "postgresql"

}

// ===========================================================================

// ENUMS

// ===========================================================================

/// Where a staff member stands with the Admin Portal.

///

/// INVITED   invited, has not set a password yet — cannot sign in

/// ACTIVE    may sign in and use whatever their roles permit

/// SUSPENDED temporarily blocked; the account and its roles stay intact

/// DISABLED  permanently closed; kept only so audit history still resolves

enum StaffStatus {

  INVITED

  ACTIVE

  SUSPENDED

  DISABLED

}

/// The thing a permission applies to.

enum PermissionResource {

  DASHBOARD

  INVESTOR

  KYC

  COMPANY

  PARTNER

  OPPORTUNITY

  INVESTMENT_RULE

  INVESTMENT_REQUEST

  FINANCE

  DOCUMENT

  REPORT

  STAFF

  ROLE

  PERMISSION

  SETTINGS

  AUDIT

}

/// What may be done to a resource.

enum PermissionAction {

  VIEW

  CREATE

  EDIT

  DELETE

  APPROVE

  REJECT

  VERIFY

  MANAGE

  EXPORT

}

/// Groups audit entries so the viewer can filter them sensibly.

enum AuditCategory {

  AUTH

  STAFF

  ROLE

  PERMISSION

  SECURITY

  SETTINGS

  COMPANY

  INVESTMENT_RULE

  OPPORTUNITY

  INVESTOR

}

/// Who owns a company: Afaq itself, or an approved outside partner.

///

/// Drives marketplace ordering — Afaq's own companies come first — and the

/// vetting rules: an internal company has nothing to verify.

enum CompanyType {

  INTERNAL

  THIRD_PARTY

}

/// Whether a company is trading with us right now.

///

/// Deliberately not a delete: a company that stops trading keeps its history,

/// its documents and any investments made in it. INACTIVE hides it from the

/// marketplace; SUSPENDED is the same but says a decision was taken.

enum CompanyStatus {

  ACTIVE

  INACTIVE

  SUSPENDED

}

/// How far an outside company has got through vetting.

///

/// NOT_REQUIRED is the resting state for Afaq's own companies — they are not

/// "unverified", the question does not apply to them. Kept apart from

/// CompanyStatus because the two answer different questions: "have we checked

/// them?" and "are they trading?" A verified company can still be inactive.

enum CompanyVerification {

  NOT_REQUIRED

  PENDING

  UNDER_REVIEW

  VERIFIED

  REJECTED

}

/// Whether the money is tied up for a fixed term or withdrawable on notice.

enum InvestmentMode {

  LOCKED

  UNLOCKED

}

/// The period a return percentage is quoted over.

///

/// "4%" means nothing on its own — 4% a month and 4% a year differ by a factor

/// of twelve. Every rule set says which it means, so the figure can never be

/// read the wrong way round.

enum RoiBasis {

  MONTHLY

  QUARTERLY

  ANNUAL

}

/// How often a return actually reaches the investor.

enum PayoutFrequency {

  MONTHLY

  QUARTERLY

  SEMI_ANNUAL

  ANNUAL

  ON_MATURITY

}

/// Where a rule set is in its life.

///

/// DRAFT may be edited freely. ACTIVE is what investors are being sold today

/// and is read-only. ARCHIVED was ACTIVE once; investments sold under it still

/// point at it, which is the entire reason it is kept rather than deleted.

enum RuleSetStatus {

  DRAFT

  ACTIVE

  ARCHIVED

}

/// Whether a ladder applies platform-wide or to one company only.

enum RuleSetScope {

  GLOBAL

  COMPANY

}

/// The lifecycle of an investment raise.
enum OpportunityStatus {

  DRAFT

  OPEN

  SUSPENDED

  FULLY_FUNDED

  CLOSED

  CANCELLED

}

// ===========================================================================
// INVESTOR & KYC ENUMS
// ===========================================================================

enum InvestorType {
  INDIVIDUAL
  CORPORATE
}

enum InvestorSource {
  SELF_REGISTERED
  STAFF_INVITED
}

enum InvestorStatus {
  INVITED
  ACTIVE
  SUSPENDED
  CLOSED
}

// Stored KYC standing. EXPIRED is calculated from kycExpiresAt and is never stored.
enum KycStoredStanding {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
}

enum KycSubmissionStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum KycDocumentKind {
  EMIRATES_ID_FRONT
  EMIRATES_ID_BACK
  PASSPORT
  PROOF_OF_ADDRESS
  TRADE_LICENCE
  MEMORANDUM_OF_ASSOCIATION
  PARTY_ID
  SOURCE_OF_FUNDS
  OTHER
}

enum KycDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Authentication and security events, kept apart from the audit trail.

///

/// LOGIN_FAILED is a wrong password — a person's mistake.

/// LOGIN_BLOCKED is a correct password refused because the account is

/// suspended or disabled, which is a security signal worth watching.

enum AuthEventType {

  LOGIN_SUCCESS

  LOGIN_FAILED

  LOGIN_BLOCKED

  LOGOUT

  PASSWORD_RESET_REQUESTED

  PASSWORD_RESET_COMPLETED

  INVITATION_SENT

  INVITATION_ACCEPTED

  SESSION_REVOKED

}

// ===========================================================================

// STAFF

// ===========================================================================

/// A member of Afaq Invest staff who may use the Admin Portal.

///

/// Passwords and sessions live in Supabase; `authUserId` is the link. It is

/// null only between sending an invitation and Supabase creating the account,

/// and the API refuses every request where it is null.

model StaffUser {

  id String @id @default(uuid()) @db.Uuid

  /// Supabase auth.users.id. Null only while an invitation is in flight.

  authUserId String? @unique @map("auth_user_id") @db.Uuid

  /// Always stored lowercase: the human identifier and the invitation address.

  email    String  @unique

  fullName String  @map("full_name")

  jobTitle String? @map("job_title")

  phone    String?

  /// Supabase Storage path for the profile photo.

  avatarUrl String? @map("avatar_url")

  status StaffStatus @default(INVITED)

  /// Which language to write to this person in.

  preferredLocale String @default("en") @map("preferred_locale")

  // --- invitation lifecycle (no separate model: these belong to one person)

  invitedAt           DateTime? @map("invited_at")

  invitationExpiresAt DateTime? @map("invitation_expires_at")

  invitationSentCount Int       @default(0) @map("invitation_sent_count")

  invitedById         String?   @map("invited_by_id") @db.Uuid

  // --- activity

  activatedAt DateTime? @map("activated_at")

  lastLoginAt DateTime? @map("last_login_at")

  lastSeenAt  DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  // --- relations

  invitedBy    StaffUser?  @relation("StaffInvitations", fields: [invitedById], references: [id], onDelete: SetNull)

  invitedStaff StaffUser[] @relation("StaffInvitations")

  roles StaffUserRole[] @relation("StaffUserRoles")

  /// Role assignments this person made for others.

  roleAssignmentsMade StaffUserRole[] @relation("RoleAssignedBy")

  rolesCreated Role[] @relation("RoleCreatedBy")

  companiesCreated Company[] @relation("CompanyCreatedBy")

  ruleSetsCreated   InvestmentRuleSet[] @relation("RuleSetCreatedBy")

  ruleSetsPublished InvestmentRuleSet[] @relation("RuleSetPublishedBy")

  investmentSettingsUpdated InvestmentSettings[] @relation("InvestmentSettingsUpdatedBy")

  auditEntries   AuditLog[]

  authActivities AuthActivity[]

  opportunitiesCreated InvestmentOpportunity[] @relation("OpportunityCreatedBy")

  opportunitiesOpened InvestmentOpportunity[] @relation("OpportunityOpenedBy")

  opportunitiesClosed InvestmentOpportunity[] @relation("OpportunityClosedBy")

  // Investor invitation and compliance review provenance.
  investorsInvited Investor[] @relation("InvestorInvitedBy")
  kycSubmissionsSubmitted KycSubmission[] @relation("KycSubmissionSubmittedBy")
  kycSubmissionsVerified KycSubmission[] @relation("KycSubmissionVerifiedBy")
  kycSubmissionsDecided KycSubmission[] @relation("KycSubmissionDecidedBy")
  kycDocumentsUploaded KycDocument[] @relation("KycDocumentUploadedBy")
  kycDocumentsReviewed KycDocument[] @relation("KycDocumentReviewedBy")
  complianceSettingsUpdated ComplianceSettings[] @relation("ComplianceSettingsUpdatedBy")

  @@index([status])

  @@index([email])

  @@index([lastLoginAt])

  @@map("staff_users")

}

// ===========================================================================

// ROLES AND PERMISSIONS

// ===========================================================================

/// A named bundle of permissions.

///

/// The eight roles from the specification are seeded with isSystem = true and

/// are protected from renaming and deletion. Custom roles are ordinary rows.

/// SUPER_ADMIN's override lives in one constant in the API, not in this table.

model Role {

  id String @id @default(uuid()) @db.Uuid

  /// Stable identifier used in code, e.g. SUPER_ADMIN.

  key         String  @unique

  name        String

  description String?

  /// Seeded roles that must not be renamed or deleted.

  isSystem Boolean @default(false) @map("is_system")

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy   StaffUser?       @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  permissions RolePermission[]

  staff       StaffUserRole[]

  @@index([isSystem])

  @@map("roles")

}

/// One thing that may be done to one resource, e.g. STAFF + CREATE.

///

/// Seeded and never created through the UI: the set of permissions is decided

/// by what the software can actually do.

model Permission {

  id String @id @default(uuid()) @db.Uuid

  /// Dotted form used across the API and the frontend, e.g. "staff.create".

  key String @unique

  resource    PermissionResource

  action      PermissionAction

  description String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([resource, action])

  @@index([resource])

  @@map("permissions")

}

/// Which permissions a role carries.

model RolePermission {

  roleId       String @map("role_id") @db.Uuid

  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])

  @@index([permissionId])

  @@map("role_permissions")

}

/// Which roles a staff member holds.

///

/// Who granted a privilege, and when, is itself an audit question — so it is

/// recorded on the assignment rather than only in the audit log.

model StaffUserRole {

  staffUserId String @map("staff_user_id") @db.Uuid

  roleId      String @map("role_id") @db.Uuid

  assignedAt   DateTime @default(now()) @map("assigned_at")

  assignedById String?  @map("assigned_by_id") @db.Uuid

  staffUser  StaffUser  @relation("StaffUserRoles", fields: [staffUserId], references: [id], onDelete: Cascade)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedBy StaffUser? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([staffUserId, roleId])

  @@index([roleId])

  @@map("staff_user_roles")

}

// ===========================================================================

// AUDIT AND SECURITY RECORDS

// ===========================================================================

/// What changed, who changed it, and what it looked like before and after.

///

/// Written by the API only. There is deliberately no update or delete path:

/// audit records are security records, not ordinary data.

model AuditLog {

  id String @id @default(uuid()) @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at")

  actorStaffUserId String? @map("actor_staff_user_id") @db.Uuid

  /// Copied at write time, so the entry still names someone after that staff

  /// member is removed.

  actorEmail String @map("actor_email")

  category AuditCategory

  /// Dotted event name, e.g. "staff.role_assigned".

  action String

  /// What was acted upon: "StaffUser", "Role", "Permission".

  targetType String? @map("target_type")

  targetId   String? @map("target_id")

  /// Readable name at the time, e.g. the person's email.

  targetLabel String? @map("target_label")

  /// State before and after, for changes worth reconstructing. Never contains

  /// passwords, tokens or secrets.

  before Json?

  after  Json?

  metadata Json?

  ipAddress String? @map("ip_address")

  userAgent String? @map("user_agent")

  actor StaffUser? @relation(fields: [actorStaffUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])

  @@index([category, occurredAt])

  @@index([actorStaffUserId])

  @@index([targetType, targetId])

  @@map("audit_logs")

}

/// Sign-ins, sign-outs, password resets and other security events.

///

/// Separate from AuditLog: it answers "who tried to get in?", arrives at a

/// different volume, and powers the login history in Settings → Security.

/// Each event is written to one of the two, never both.

model AuthActivity {

  id String @id @default(uuid()) @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at")

  staffUserId String? @map("staff_user_id") @db.Uuid

  /// The address used in the attempt — a failed sign-in may match no account.

  email String

  event     AuthEventType

  succeeded Boolean       @default(true)

  /// Short reason for a refusal, e.g. "invalid_credentials", "suspended".

  /// Never contains the password or any token.

  failureReason String? @map("failure_reason")

  ipAddress String? @map("ip_address")

  userAgent String? @map("user_agent")

  /// Friendly device summary shown in login history, e.g. "Chrome on Windows".

  deviceLabel String? @map("device_label")

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])

  @@index([staffUserId, occurredAt])

  @@index([email, occurredAt])

  @@index([event, occurredAt])

  @@map("auth_activities")

}

// ===========================================================================

// COMPANIES

// ===========================================================================

/// A company investors can put money into.

///

/// Covers both Afaq's own nine companies and, later, approved outside

/// partners. One model rather than two: they are the same thing to an

/// investor, they appear in the same marketplace, and splitting them would

/// duplicate every field and every query for the sake of one enum value.

///

/// Nothing financial lives here. Opportunities, tiers and returns arrive in

/// later phases and point at this record.

model Company {

  id String @id @default(uuid()) @db.Uuid

  /// URL-safe name, unique across the platform.

  ///

  /// Generated from the name once, when the company is created, and then left

  /// alone: it ends up in links people bookmark and share, and a slug that

  /// follows a rename quietly breaks all of them.

  slug String @unique

  name String

  /// The registered trading name, where it differs from the one investors see

  /// — "Afaq Al Manzil Properties LLC" against "Afaq Al Manzil Properties".

  legalName String? @map("legal_name")

  type         CompanyType

  status       CompanyStatus       @default(ACTIVE)

  verification CompanyVerification @default(NOT_REQUIRED)

  /// Free text, not an enum: Settings → Sectors lets an administrator add a

  /// sector, and an enum would make that a migration and a deployment.

  sector String

  description String? @db.Text

  /// Supabase Storage paths, not public URLs — the bucket may be private and

  /// a stored URL would expire.

  logoUrl       String? @map("logo_url")

  coverImageUrl String? @map("cover_image_url")

  website      String?

  contactEmail String? @map("contact_email")

  contactPhone String? @map("contact_phone")

  /// Promoted in the marketplace.

  isFeatured Boolean @default(false) @map("is_featured")

  /// Hand-set ordering, low first. Seeded in steps of ten so a company can be

  /// moved between two others without renumbering the rest.

  displayOrder Int @default(0) @map("display_order")

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  // --- relations

  createdBy StaffUser? @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Ladders written for this company specifically, where it does not use the

  /// platform-wide one.

  ruleSets InvestmentRuleSet[]

  opportunities InvestmentOpportunity[]

  /// The marketplace's own query: active companies, featured first, then by

  /// hand-set order. One index covers it.

  @@index([status, isFeatured, displayOrder])

  @@index([type, status])

  @@index([sector])

  @@map("companies")

}

// ===========================================================================

// INVESTMENT CONFIGURATION

// ===========================================================================

/// The values that bound every ladder.

///

/// One row. `id` is the fixed string "global" rather than a uuid so the

/// service can upsert it without first looking to see whether it exists, and

/// so a second row would have to be asked for by name.

///

/// All of it is editable from the Admin Portal, because all of it is a

/// business decision that will change.

model InvestmentSettings {

  id String @id @default("global")

  /// ISO 4217. "AED" today; nothing in the code assumes it.

  currency String @default("AED")

  /// Nobody may invest less than this, and every ladder must start here.

  minimumInvestment Decimal @default(0) @map("minimum_investment") @db.Decimal(18, 2)

  /// No option's return may exceed this, once both are put on the same basis.

  maxRoiPercent Decimal  @default(10) @map("max_roi_percent") @db.Decimal(6, 3)

  maxRoiBasis   RoiBasis @default(MONTHLY) @map("max_roi_basis")

  /// Offered as the default when an option is added. Not enforced.

  defaultNoticePeriodDays Int @default(90) @map("default_notice_period_days")

  /// Whether publishing a rule set requires the administrator to re-enter

  /// their own password. On by default: these numbers decide what the

  /// business owes people.

  requireStepUpToPublish Boolean @default(true) @map("require_step_up_to_publish")

  updatedById String?  @map("updated_by_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at")

  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy StaffUser? @relation("InvestmentSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("investment_settings")

}

/// One version of a whole tier ladder.

///

/// A live ladder is never edited. Changing the rules publishes a new version

/// and archives the old one, because an investor who was sold 6% must keep

/// getting 6% after the business drops that tier to 5% — and there must be a

/// record proving what they were actually offered. Every investment points at

/// the version it was sold under.

model InvestmentRuleSet {

  id String @id @default(uuid()) @db.Uuid

  name    String

  version Int    @default(1)

  scope     RuleSetScope @default(GLOBAL)

  /// Set when the scope is COMPANY.

  companyId String?      @map("company_id") @db.Uuid

  /// "GLOBAL", or the company's id. Always set, and derived from the two

  /// fields above — it exists so versions can be numbered per ladder line,

  /// which a nullable companyId cannot do: Postgres treats rows containing a

  /// null as distinct in a unique index, so global versions would go

  /// unconstrained.

  scopeKey String @map("scope_key")

  status RuleSetStatus @default(DRAFT)

  /// The period every percentage in this ladder is quoted over. One setting

  /// for the whole ladder, so its tiers are always comparable with each other.

  roiBasis RoiBasis @default(MONTHLY) @map("roi_basis")

  notes String? @db.Text

  effectiveFrom DateTime? @map("effective_from")

  effectiveTo   DateTime? @map("effective_to")

  /// Equal to `scopeKey` while this rule set is ACTIVE, and null otherwise.

  ///

  /// The unique index below is what actually guarantees one live ladder per

  /// scope. Postgres treats nulls as distinct, so any number of drafts and

  /// archived versions sit alongside each other untouched — but two

  /// administrators publishing at the same moment cannot both win.

  activeKey String? @unique @map("active_key")

  createdById   String?   @map("created_by_id") @db.Uuid

  publishedById String?   @map("published_by_id") @db.Uuid

  publishedAt   DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  // --- relations

  /// Restrict, not Cascade: a company with a ladder cannot be deleted. There

  /// is no delete path for companies anyway, and this makes that structural.

  company     Company?   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdBy   StaffUser? @relation("RuleSetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  publishedBy StaffUser? @relation("RuleSetPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  tiers InvestmentTier[]

  opportunities InvestmentOpportunity[]

  @@unique([scopeKey, version])

  @@index([scope, status])

  @@index([companyId, status])

  @@map("investment_rule_sets")

}

/// One amount range within a ladder.

///

/// A tier is a range and nothing else. How it behaves belongs to its options

/// below, because locking and unlocking differ in return, term and notice —

/// two rows say that plainly where one row of nullable columns would not.

///

/// Ranges are written the way people say them (1,000,001 to 2,000,000) and

/// matched on their floors alone, so a validated ladder cannot leave a crack

/// for an odd amount to fall through.

model InvestmentTier {

  id String @id @default(uuid()) @db.Uuid

  ruleSetId String @map("rule_set_id") @db.Uuid

  name String

  minAmount Decimal  @map("min_amount") @db.Decimal(18, 2)

  /// Null on the highest tier only, which is always open-ended.

  maxAmount Decimal? @map("max_amount") @db.Decimal(18, 2)

  displayOrder Int @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  /// Cascade is safe here and only here: tiers belong to their rule set and

  /// have no meaning apart from it. Only DRAFT rule sets are ever deleted —

  /// an archived one is what proves what somebody was sold.

  ruleSet InvestmentRuleSet      @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  options InvestmentTierOption[]

  @@unique([ruleSetId, displayOrder])

  @@index([ruleSetId, minAmount])

  @@map("investment_tiers")

}

/// How one tier behaves in one mode.

model InvestmentTierOption {

  id String @id @default(uuid()) @db.Uuid

  tierId String @map("tier_id") @db.Uuid

  mode InvestmentMode

  /// Quoted over the rule set's `roiBasis`, not over its own.

  roiPercent Decimal @map("roi_percent") @db.Decimal(6, 3)

  payoutFrequency PayoutFrequency @default(MONTHLY) @map("payout_frequency")

  /// Null means open-ended, the normal shape of an unlocked option. A locked

  /// option must have a minimum — that is what makes it locked.

  minTermMonths Int? @map("min_term_months")

  maxTermMonths Int? @map("max_term_months")

  /// Days of warning before money can leave. Zero means none.

  noticePeriodDays Int @default(0) @map("notice_period_days")

  /// Whether the investment keeps earning while notice runs. False by

  /// decision: notice is counted from the day it is given and earns nothing.

  earnsDuringNotice Boolean @default(false) @map("earns_during_notice")

  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  tier InvestmentTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  /// A tier cannot offer two locked options. The same rule is checked by

  /// `validateTierLadder` for the sake of a readable message; this is what

  /// makes it true.

  @@unique([tierId, mode])

  @@map("investment_tier_options")

}

// ===========================================================================
// INVESTMENT OPPORTUNITIES
// ===========================================================================

/// An investment raise for a company.
///
/// A draft can be edited without being visible to investors. When opened,
/// the raise pins the investment rule-set version it was offered under.
model InvestmentOpportunity {

  id String @id @default(uuid()) @db.Uuid

  /// Public, stable URL segment for the opportunity.
  slug String @unique

  companyId String @map("company_id") @db.Uuid

  title String

  summary String? @db.Text

  description String? @db.Text

  status OpportunityStatus @default(DRAFT)

  coverImageUrl String? @map("cover_image_url")

  targetAmount Decimal @map("target_amount") @db.Decimal(18, 2)

  committedAmount Decimal @default(0) @map("committed_amount") @db.Decimal(18, 2)

  opensAt DateTime? @map("opens_at")

  closesAt DateTime? @map("closes_at")

  closedAt DateTime? @map("closed_at")

  isFeatured Boolean @default(false) @map("is_featured")

  displayOrder Int @default(0) @map("display_order")

  /// The version of the ladder pinned to the opportunity when opened.
  ruleSetId String? @map("rule_set_id") @db.Uuid

  createdById String? @map("created_by_id") @db.Uuid

  openedById String? @map("opened_by_id") @db.Uuid

  closedById String? @map("closed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  ruleSet InvestmentRuleSet? @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  createdBy StaffUser? @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  openedBy StaffUser? @relation("OpportunityOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)

  closedBy StaffUser? @relation("OpportunityClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status, isFeatured, displayOrder])
  @@index([ruleSetId])
  @@index([opensAt, closesAt])
  @@map("investment_opportunities")

}

// ===========================================================================
// INVESTOR ACCOUNTS & COMPLIANCE — INVESTOR MANAGEMENT
// ===========================================================================

/// An investor has a permanent record once any KYC work exists.
/// Supabase owns the actual login; authUserId is only a reference to it.
model Investor {
  id String @id @default(uuid()) @db.Uuid
  number Int @unique @default(autoincrement())
  authUserId String? @unique @map("auth_user_id") @db.Uuid

  type InvestorType
  source InvestorSource @default(SELF_REGISTERED)
  email String @unique
  displayName String @map("display_name")
  phone String?
  countryOfResidence String? @map("country_of_residence")
  preferredLocale String @default("en") @map("preferred_locale")
  status InvestorStatus @default(INVITED)

  // A materialized standing. EXPIRED is computed at read time.
  kycStatus KycStoredStanding @default(NOT_STARTED) @map("kyc_status")
  riskRating RiskRating? @map("risk_rating")
  kycApprovedAt DateTime? @map("kyc_approved_at")
  kycExpiresAt DateTime? @map("kyc_expires_at")

  invitedAt DateTime? @map("invited_at")
  invitationExpiresAt DateTime? @map("invitation_expires_at")
  invitationSentCount Int @default(0) @map("invitation_sent_count")
  invitedById String? @map("invited_by_id") @db.Uuid
  activatedAt DateTime? @map("activated_at")
  closedAt DateTime? @map("closed_at")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invitedBy StaffUser? @relation("InvestorInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  kycSubmissions KycSubmission[]

  @@index([status, createdAt])
  @@index([type, status])
  @@index([source])
  @@index([kycStatus, kycExpiresAt])
  @@index([riskRating])
  @@index([displayName])
  @@map("investors")
}

/// A historical KYC application; reviewed submissions are immutable snapshots.
model KycSubmission {
  id String @id @default(uuid()) @db.Uuid
  investorId String @map("investor_id") @db.Uuid
  investorType InvestorType @map("investor_type")
  status KycSubmissionStatus @default(DRAFT)
  riskRating RiskRating? @map("risk_rating")
  // Editable until submission. Validated against the shared KycDetails shape.
  details Json?

  submittedAt DateTime? @map("submitted_at")
  submittedByStaffId String? @map("submitted_by_staff_id") @db.Uuid
  verifiedAt DateTime? @map("verified_at")
  verifiedById String? @map("verified_by_id") @db.Uuid
  verificationNote String? @map("verification_note") @db.Text
  decidedAt DateTime? @map("decided_at")
  decidedById String? @map("decided_by_id") @db.Uuid
  decisionNote String? @map("decision_note") @db.Text
  changesRequestedNote String? @map("changes_requested_note") @db.Text
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Restrict)
  submittedByStaff StaffUser? @relation("KycSubmissionSubmittedBy", fields: [submittedByStaffId], references: [id], onDelete: SetNull)
  verifiedBy StaffUser? @relation("KycSubmissionVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  decidedBy StaffUser? @relation("KycSubmissionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  documents KycDocument[]

  @@index([investorId, createdAt])
  @@index([status, submittedAt])
  @@index([riskRating])
  @@map("kyc_submissions")
}

/// A file belongs to one immutable submission, never to an investor globally.
/// Only a private storage path is persisted, not a signed/public URL.
model KycDocument {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  kind KycDocumentKind
  partyKey String? @map("party_key")
  fileName String @map("file_name")
  mimeType String @map("mime_type")
  sizeBytes Int @map("size_bytes")
  storagePath String @map("storage_path")
  status KycDocumentStatus @default(PENDING)
  reviewNote String? @map("review_note") @db.Text
  reviewedAt DateTime? @map("reviewed_at")
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  uploadedByStaffId String? @map("uploaded_by_staff_id") @db.Uuid
  removedAt DateTime? @map("removed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewedBy StaffUser? @relation("KycDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedByStaff StaffUser? @relation("KycDocumentUploadedBy", fields: [uploadedByStaffId], references: [id], onDelete: SetNull)

  @@index([submissionId, status])
  @@index([submissionId, kind])
  @@index([uploadedByStaffId])
  @@map("kyc_documents")
}

/// Single platform-wide row; KYC validation uses these configurable limits.
model ComplianceSettings {
  id String @id @default("global")
  minimumAge Int @default(18) @map("minimum_age")
  reviewMonthsLow Int @default(36) @map("review_months_low")
  reviewMonthsMedium Int @default(24) @map("review_months_medium")
  reviewMonthsHigh Int @default(12) @map("review_months_high")
  maxDocumentBytes Int @default(10485760) @map("max_document_bytes")
  investorInvitationDays Int @default(7) @map("investor_invitation_days")
  updatedById String? @map("updated_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedBy StaffUser? @relation("ComplianceSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("compliance_settings")
}
